{
  "name": "grid-tile-editor",
  "version": "0.3.0",
  "license": "MIT",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "vinext dev -p 3200",
    "build": "node scripts/stamp-build.mjs && vinext build",
    "start": "vinext start",
    "start:test": "vinext start -p 3200",
    "deploy": "cmd /c scripts\\service.cmd deploy",
    "service": "cmd /c scripts\\service.cmd",
    "typecheck": "tsc --noEmit",
    "test": "npm run typecheck && npm run build && node --test tests/rendered-html.test.mjs tests/rendered-mobile.test.mjs && tsx --test tests/range-clipboard.test.mjs tests/multipage.test.mjs tests/render-legend.test.mjs tests/cell-text.test.mjs tests/zoom.test.mjs tests/paper.test.mjs tests/pattern.test.mjs tests/palette-collapse.test.mjs tests/layers.test.mjs tests/print-sheet.test.mjs tests/ruler-watermark.test.mjs tests/diff-photo.test.mjs tests/photo-ledger.test.mjs tests/photo-lightbox.test.mjs tests/opacity.test.mjs tests/memo-print.test.mjs tests/note-bubble.test.mjs tests/zone.test.mjs tests/device.test.mjs tests/connection.test.mjs tests/mcp-tools.test.mjs tests/projects-api.test.mjs tests/mobile-view.test.mjs",
    "lint": "eslint . --ignore-pattern dist --ignore-pattern .next",
    "db:generate": "drizzle-kit generate",
    "mcp:build": "vite build --config vite.mcp.config.ts",
    "mcp:start": "node dist-mcp/server.js",
    "mcp:dev": "tsx mcp/server.ts"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.0",
    "drizzle-orm": "0.45.2",
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.37.1",
    "@cloudflare/workers-types": "4.20260702.1",
    "@eslint/js": "9.39.4",
    "@next/eslint-plugin-next": "16.2.6",
    "@openai/sites-vite-plugin": "0.1.0",
    "@tailwindcss/postcss": "4.2.1",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.2",
    "@vitejs/plugin-rsc": "0.5.26",
    "drizzle-kit": "0.31.10",
    "eslint": "9.39.4",
    "eslint-plugin-jsx-a11y": "6.10.2",
    "eslint-plugin-react": "7.37.5",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "16.4.0",
    "react-server-dom-webpack": "19.2.6",
    "tailwindcss": "4.2.1",
    "tsx": "4.22.1",
    "typescript": "5.9.3",
    "typescript-eslint": "8.59.3",
    "vinext": "1.0.0-beta.2",
    "vite": "8.0.13",
    "wrangler": "4.92.0"
  },
  "type": "module",
  "bin": {
    "grid-tile-mcp": "dist-mcp/server.js"
  }
}
